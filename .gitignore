# Obsidian 配置目录
.obsidian/

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.tmp.*
*~

# LaTeX 编译产物
talks/**/build/

*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.idx
*.ind
*.ilg
*.glo
*.gls
*.glg
*.acn
*.acr
*.alg
*.xdy
.winuser/
tmp/

# Codex local review and scratch artifacts
.codex/docx-review-80th*/
.codex/tmp-figure1/
.codex_tmp/
.soptx-patch-link
# 顶层 .codex-* 暂存目录与补丁：研发代码归 WSL ~/workspace，不入文档仓库
.codex-*/
.codex-*.patch
.claude/settings.local.json

# Generated document QA, figure intermediates and Python caches
research/funding/active/china-postdoc-foundation-general-grant/.docx-qa/
research/funding/active/china-postdoc-foundation-general-grant/assets/dev/
**/__pycache__/
*.py[cod]

# Funding source documents are archived in iCloud, not Git
research/funding/**/*.pdf
research/funding/**/*.doc
research/funding/**/*.docx

# Local source copies in any directory; originals live in Zotero, iCloud or upstream
**/sources/

# Any subdirectory under translations/ is a local derived artifact (e.g. PDF conversion
# cache) and stays out of Git; the flat -zh.md translation notes remain tracked.
literature/**/translations/*/

# Research plan typesetting source and its outgoing PDF are archived in iCloud, not Git.
# postdoc-research-plan.md is the single source of truth for the plan text.
research/postdoc-research-plan.tex

# Local MiKTeX cache created when compiling under sandboxed user dirs
.miktex/
talks/**/.miktex/
talks/**/.miktex-userconfig/
talks/**/.miktex-userdata/
talks/**/.miktex-data/
talks/**/.miktex-pkgs/
talks/**/.fontconfig/


